# Rendered by Vault Agent. Do not edit inside the container.
DJANGO_DEBUG="False"
PG_SSL_ROOT_CERT="/vault/secrets/postgresql-ca.crt"

{{ with secret "kv/data/POSTGRESQL" -}}
{{ range $key, $value := .Data.data -}}
{{ if ne $key "POSTGRESQL_CRT" }}{{ $key }}={{ $value | toJSON }}
{{ end -}}
{{ end -}}
PG_MASTER_USER={{ .Data.data.POSTGRESQL_USERNAME | toJSON }}
PG_MASTER_PASSWORD={{ .Data.data.POSTGRESQL_PASSWORD | toJSON }}
PG_MASTER_HOST={{ .Data.data.POSTGRESQL_MASTER_HOST | toJSON }}
PG_MASTER_PORT={{ .Data.data.POSTGRESQL_MASTER_PORT | toJSON }}
PG_REPLICA_HOST_1={{ .Data.data.POSTGRESQL_REPLICA_HOST_1 | toJSON }}
{{ end }}

{{ with secret "kv/data/DJANGO" -}}
{{ range $key, $value := .Data.data -}}
{{ $key }}={{ $value | toJSON }}
{{ end -}}
{{ end }}

{{ with secret "kv/data/AWS_SES" -}}
{{ range $key, $value := .Data.data -}}
{{ $key }}={{ $value | toJSON }}
{{ end -}}
EMAIL_PORT={{ .Data.data.AWS_SES_EMAIL_PORT | toJSON }}
EMAIL_HOST={{ .Data.data.AWS_SES_EMAIL_HOST | toJSON }}
EMAIL_USE_TLS={{ .Data.data.AWS_SES_EMAIL_USE_TLS | toJSON }}
EMAIL_HOST_USER={{ .Data.data.AWS_SES_EMAIL_HOST_USER | toJSON }}
EMAIL_HOST_PASSWORD={{ .Data.data.AWS_SES_EMAIL_HOST_PASSWORD | toJSON }}
EMAIL_USE_SSL={{ .Data.data.AWS_SES_EMAIL_USE_SSL | toJSON }}
EMAIL_SENDER_ADDRESS={{ .Data.data.AWS_SES_EMAIL_SENDER_ADDRESS | toJSON }}
{{ end }}

{{ with secret "kv/data/CELERY" -}}
{{ range $key, $value := .Data.data -}}
{{ $key }}={{ $value | toJSON }}
{{ end -}}
{{ end }}

{{ with secret "kv/data/REDIS" -}}
{{ range $key, $value := .Data.data -}}
{{ $key }}={{ $value | toJSON }}
{{ end -}}
{{ end }}

{{ with secret "kv/data/KAFKA" -}}
{{ range $key, $value := .Data.data -}}
{{ $key }}={{ $value | toJSON }}
{{ end -}}
{{ end }}

{{ with secret "kv/data/ELASTICSEARCH" -}}
{{ range $key, $value := .Data.data -}}
{{ $key }}={{ $value | toJSON }}
{{ end -}}
{{ end }}

{{ with secret "kv/data/CLOUDFLARE" -}}
{{ range $key, $value := .Data.data -}}
{{ $key }}={{ $value | toJSON }}
{{ end -}}
ELASTICSEARCH_CLIENT_ID={{ .Data.data.CF_ACCESS_CLIENT_ID | toJSON }}
ELASTICSEARCH_CLIENT_SECRET={{ .Data.data.CF_ACCESS_CLIENT_SECRET | toJSON }}
{{ end }}

{{ with secret "kv/data/GOOGLE_OAUTH" -}}
{{ range $key, $value := .Data.data -}}
{{ $key }}={{ $value | toJSON }}
{{ end -}}
{{ end }}

{{ with secret "kv/data/MICROSOFT_OAUTH" -}}
{{ range $key, $value := .Data.data -}}
{{ $key }}={{ $value | toJSON }}
{{ end -}}
{{ end }}
